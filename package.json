{
  "name": "originlens",
  "version": "0.0.1",
  "private": true,
  "description": "Privacy-first phishing detection for Chrome. See who a site really is.",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "wxt build --mv3",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "deploy:test-download": "bash scripts/deploy-test-download.sh",
    "dev": "wxt --mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "package:test-download": "bash scripts/package-test-download.sh",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:banks:live": "pnpm build && playwright test --config playwright.live-banks.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:fixtures": "node scripts/serve-fixtures.mjs",
    "test:watch": "vitest",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "punycode": "2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldts": "7.4.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.2.6",
    "@types/node": "22.20.1",
    "@types/punycode": "2.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
